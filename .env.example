# Frontend (Vite). Copy to .env.local for local development.
# On Vercel, set the same name under Project Settings -> Environment Variables.

# Origin of the backend API (your Render web service), no trailing slash.
# Leave EMPTY for local development: the Vite dev server proxies /api to http://localhost:4000.
VITE_API_URL=

# Everything here is bundled into the public JavaScript. Never put secrets in a VITE_ variable.
# Backend settings live in server/.env.example and are set on Render, not here.
