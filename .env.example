# Copy to .env.local for local development. Never commit real values.
# On Netlify, set the same two names under Site configuration > Environment variables.

# Browser-safe. Both ship in the client bundle; Row Level Security protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# NEVER prefix any of the following with VITE_ and never put them in Netlify's
# site env vars. They are for running migrations from a trusted shell only:
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
