# Copy to .env for local development. Never commit real values (.env is gitignored).
# On Render, set these under the Web Service's Environment tab instead.

# --- Required ---------------------------------------------------------------
# Local:   postgres://smartnest:smartnest@localhost:5432/smartnest_dev
# Render:  paste the Postgres instance's *Internal Database URL*
DATABASE_URL=postgres://smartnest:smartnest@localhost:5432/smartnest_dev

# Browser origins allowed to call this API, comma-separated, no trailing slash.
# Put your Vercel production URL here (and localhost for dev).
CORS_ORIGINS=http://localhost:5173

# Public URL of the frontend; used to build password-reset links.
APP_URL=http://localhost:5173

# --- Optional ---------------------------------------------------------------
# PORT=4000                 # Render sets this itself; do not set it there
# NODE_ENV=production       # set on Render
# DATABASE_SSL=off          # off | require | no-verify. Default: no-verify for *.render.com hosts
# SESSION_TTL_DAYS=30
# RESET_TOKEN_TTL_MINUTES=60

# Password-reset email via Resend's HTTP API. Without these, no email is sent.
# RESEND_API_KEY=
# MAIL_FROM=SmartNest <onboarding@resend.dev>
# Print reset links in the server log instead (demo only; default on outside production).
# MAIL_LOG_LINKS=true

# Creates the first admin on boot if the email is unused. Never promotes an existing account.
# Remove the password from the environment after first sign-in.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=choose-a-long-passphrase
# BOOTSTRAP_ADMIN_NAME=SmartNest Admin
